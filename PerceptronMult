import numpy as np

class MLP:
    def __init__(self, input_size, hidden_size, output_size, lr=0.1, epochs=1000):
        self.W1 = np.random.randn(input_size, hidden_size)
        self.b1 = np.zeros(hidden_size)
        self.W2 = np.random.randn(hidden_size, output_size)
        self.b2 = np.zeros(output_size)
        self.lr = lr
        self.epochs = epochs

    def sigmoid(self, x):
        return 1 / (1 + np.exp(-x))

    def softmax(self, x):
        exp_x = np.exp(x - np.max(x, axis=1, keepdims=True))
        return exp_x / np.sum(exp_x, axis=1, keepdims=True)

    def predict(self, X):
        self.z1 = np.dot(X, self.W1) + self.b1
        self.a1 = self.sigmoid(self.z1)
        z2 = np.dot(self.a1, self.W2) + self.b2
        return self.softmax(z2)

    def train(self, X, y):
        for epoch in range(self.epochs):
            output = self.predict(X)
            loss = -np.mean(np.sum(y * np.log(output + 1e-9), axis=1))

            d2 = (output - y)# gradient de la couch de sorti
            d1 = np.dot(d2, self.W2.T) * self.a1 * (1 - self.a1)# gradient de la couche cacher

            self.W2 -= self.lr * np.dot(self.a1.T, d2)
            self.b2 -= self.lr * np.sum(d2, axis=0)
            self.W1 -= self.lr * np.dot(X.T, d1)
            self.b1 -= self.lr * np.sum(d1, )

            if epoch % 100 == 0:
                print(f"Epoch {epoch}, Loss: {loss:.4f}")

# XOR en one-hot encoding (multi-classes)
X = np.array([[0,0], [0,1], [1,0], [1,1]])
y = np.array([[1, 0], [0, 1], [0, 1], [1, 0]]) # one-hot

mlp = MLP(input_size=2, hidden_size=2, output_size=2, lr=0.5, epochs=10000)
mlp.train(X, y)

for i in range(len(X)):
    pred = mlp.predict(X[i].reshape(1, -1))[0]
    print(f"{X[i]} -> {pred}")